# ── Build stage ──
FROM golang:1.26.3-bookworm AS builder
WORKDIR /src
COPY go.mod go.sum ./
# Cache Go module downloads across builds
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
# Cache Go modules and compiler output for incremental builds
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 go build -o /out/gokohime-bot ./cmd/bot

# ── Runtime stage ──
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates sqlite3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /out/gokohime-bot .

VOLUME ["/app/data"]
ENTRYPOINT ["./gokohime-bot"]
CMD ["-c", "config.yaml"]
