# ── Build stage ──
FROM golang:1.24-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -o /out/gokohime-bot ./cmd/bot

# ── Runtime stage ──
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates sqlite3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /out/gokohime-bot .

VOLUME ["/app/data"]
ENTRYPOINT ["./gokohime-bot"]
CMD ["-c", "config.yaml"]
